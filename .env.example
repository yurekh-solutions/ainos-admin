# AINOS Admin Panel Environment Variables

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ainos"

# Session signing key. The admin_session cookie is an HMAC-signed, expiring
# token built from this value; set NEXTAUTH_SECRET (or ADMIN_SESSION_SECRET)
# in every deployed environment, otherwise each restart logs operators out.
# Generate: node -p "require('crypto').randomBytes(32).toString('hex')"
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-here
# ADMIN_SESSION_SECRET=optional-preferred-over-nextauth-secret

# Admin Access - comma-separated allow-list, checked on every request
ADMIN_EMAILS=admin@yurekh.com,info.ainosio@gmail.com

# bcrypt hash of the operator password (scripts/_setAdminPassword.cjs writes it).
# Login fails closed when this is missing; the password itself is never stored.
ADMIN_PASSWORD_HASH=$2b$10$replace-with-a-bcrypt-hash

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# Cloudinary (for document uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
